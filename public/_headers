# Charlizi Factory — Security & SEO Headers (Cloudflare Pages)

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  X-DNS-Prefetch-Control: off
  X-Permitted-Cross-Domain-Policies: none
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://cloudflareinsights.com https://open.feishu.cn https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com https://www.youtube.com; media-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests

# Admin / CMS: never index, never frame, no caching of auth pages
/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store, max-age=0
  X-Frame-Options: DENY

/manage/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store, max-age=0
  X-Frame-Options: DENY

/dashboard/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store, max-age=0
  X-Frame-Options: DENY

# API: never index, never cache
/api/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store, max-age=0
  X-Content-Type-Options: nosniff

# Static assets: long cache, immutable
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/factory/images/*
  Cache-Control: public, max-age=2592000

# sitemap / robots: short cache so changes propagate fast
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=1800

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=1800
