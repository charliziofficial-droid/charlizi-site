---
// src/pages/admin.astro
// Astro page to serve Decap CMS at /admin/
---
<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Charlizi Factory — CMS Admin</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; background: #0f1729; color: white; }
    .loading { text-align: center; }
    .loading h2 { font-weight: 500; font-size: 1.25rem; margin-top: 1rem; }
    .spinner { width: 40px; height: 40px; border: 3px solid rgba(255,255,255,0.1); border-top-color: #b8865c; border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto; }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
  <script src="https://unpkg.com/decap-cms@3.13.0/dist/decap-cms.js"></script>
</head>
<body>
  <div class="loading" id="loading">
    <div class="spinner"></div>
    <h2>Loading Admin Panel...</h2>
  </div>
  <script>
    // Hide loading once CMS has loaded
    document.addEventListener('DOMContentLoaded', function() {
      var check = setInterval(function() {
        if (window.CMS && document.querySelector('.nc-app')) {
          document.getElementById('loading').style.display = 'none';
          clearInterval(check);
        }
      }, 500);
      // Timeout fallback
      setTimeout(function() { document.getElementById('loading').style.display = 'none'; }, 8000);
    });
  </script>
  <script>
    // Decap CMS config inline — auto-init on load
    window.CMS_MANUAL_INIT = true;
    document.addEventListener('DOMContentLoaded', function() {
      var waitForCMS = setInterval(function() {
        if (window.CMS && typeof CMS.init === 'function') {
          clearInterval(waitForCMS);
          CMS.init({
            config: {
              backend: {
                name: 'github',
                repo: 'charliziofficial-droid/charlizi-site',
                branch: 'main'
              },
              media_folder: 'public/uploads',
              public_folder: '/uploads',
              slug: {
                encoding: 'ascii',
                clean_accents: true
              },
              collections: [
                {
                  name: 'blog',
                  label: 'Blog Posts',
                  folder: 'src/pages/blog',
                  create: true,
                  extension: 'astro',
                  format: 'frontmatter',
                  slug: '{{slug}}',
                  fields: [
                    { label: 'Title', name: 'title', widget: 'string' },
                    { label: 'Description', name: 'description', widget: 'string' },
                    { label: 'Publish Date', name: 'date', widget: 'datetime' },
                    { label: 'Body', name: 'body', widget: 'markdown' }
                  ]
                },
                {
                  name: 'site',
                  label: 'Site Content',
                  files: [
                    {
                      label: 'Factory Info',
                      name: 'site-content',
                      file: 'src/data/site-content.json',
                      fields: [
                        { label: 'Brand Name', name: 'brandName', widget: 'string' },
                        { label: 'Tagline', name: 'brandTagline', widget: 'string' },
                        { label: 'Hero Title', name: 'heroTitle', widget: 'text' },
                        { label: 'Hero Subtitle', name: 'heroSubtitle', widget: 'text' },
                        { label: 'Workers', name: 'workers', widget: 'string' },
                        { label: 'Area', name: 'area', widget: 'string' },
                        { label: 'Annual Output', name: 'annualOutput', widget: 'string' },
                        { label: 'Monthly Containers', name: 'monthlyContainers', widget: 'string' },
                        { label: 'Founded', name: 'founded', widget: 'string' }
                      ]
                    },
                    {
                      label: 'FAQ',
                      name: 'faq',
                      file: 'src/data/faq.json',
                      fields: [
                        { label: 'FAQ Items (edit in file)', name: 'note', widget: 'text', required: false }
                      ]
                    }
                  ]
                }
              ]
            }
          });
        }
      }, 300);
    });
  </script>
</body>
</html>
