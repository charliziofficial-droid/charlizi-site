---
// src/pages/index.astro — B2B Factory Homepage
import FactoryLayout from '../layouts/FactoryLayout.astro';
import { factoryStats, certifications, productCategories } from '../data/products-b2b.js';
---
<FactoryLayout
  title="Intimate Apparel OEM Manufacturer | Lingerie Factory China"
  description="Charlizi Factory — professional lingerie & intimate apparel OEM/ODM manufacturer. BSCI & OEKO-TEX certified. 200+ workers, 5,000㎡ facility. Bras, shapewear, panties, silicone bras & custom sleepwear. MOQ 200 pcs. Small batch sample available."
>
  <!-- Hero -->
  <section class="relative bg-navy overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-navy-light to-navy-dark opacity-90"></div>
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 25% 50%, white 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="container-site relative z-10 py-20 md:py-28">
      <div class="max-w-3xl">
        <span class="section-label text-accent/80 text-white/80">OEM/ODM MANUFACTURER SINCE 2018</span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white mt-4 leading-[1.1] tracking-tight">
          Your Trusted <br />
          <span class="text-accent">Intimate Apparel</span><br />
          Manufacturing Partner
        </h1>
        <p class="text-white/70 text-base sm:text-lg mt-6 max-w-xl leading-relaxed">
          Lingerie, shapewear, panties, and silicone bras — 
          from design to delivery. BSCI & OEKO-TEX certified quality.
        </p>
        <div class="flex flex-wrap gap-4 mt-10">
          <a href="/products" class="btn-accent text-sm px-8 py-4 font-semibold">
            Browse Catalog
          </a>
          <a href="/contact" class="inline-flex items-center justify-center border-2 border-white/30 text-white px-8 py-4 font-medium text-sm hover:bg-white/10 transition-colors">
            Request a Quote
          </a>
          <a href="https://viomisha.com" target="_blank" class="inline-flex items-center justify-center text-white/70 px-8 py-4 font-medium text-sm hover:text-white transition-colors gap-2">
            📦 Small Batch Sample
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="bg-cream border-y border-gray-200">
    <div class="container-site py-8 md:py-10">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-6 text-center">
        <div><div class="text-2xl md:text-3xl font-bold text-navy">{factoryStats.workers}</div><div class="text-xs text-slate mt-1">Skilled Workers</div></div>
        <div><div class="text-2xl md:text-3xl font-bold text-navy">{factoryStats.area}</div><div class="text-xs text-slate mt-1">Facility Area</div></div>
        <div><div class="text-2xl md:text-3xl font-bold text-navy">{factoryStats.annualOutput}</div><div class="text-xs text-slate mt-1">Annual Output</div></div>
        <div><div class="text-2xl md:text-3xl font-bold text-navy">{factoryStats.monthlyContainers}</div><div class="text-xs text-slate mt-1">Monthly Shipments</div></div>
        <div><div class="text-2xl md:text-3xl font-bold text-navy">200-300</div><div class="text-xs text-slate mt-1">MOQ (pcs/design)</div></div>
      </div>
    </div>
  </section>

  <!-- Product Categories Overview -->
  <section class="container-site section-padding">
    <div class="text-center mb-12">
      <span class="section-label">Product Categories</span>
      <h2 class="section-title">Full Range of Intimate Apparel</h2>
      <p class="section-desc mx-auto">7 product lines covering bras, panties, shapewear, and more. Custom OEM/ODM development available.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
      {productCategories.map(cat => (
        <a href={`/products/${cat.slug}`} class="card-hover group p-6">
          <div class="aspect-[4/3] bg-cream-dark mb-4 flex items-center justify-center text-4xl text-navy/20 overflow-hidden">
            <div class="w-full h-full bg-gradient-to-br from-navy/5 to-accent/5 group-hover:scale-105 transition-transform duration-300"></div>
          </div>
          <h3 class="font-semibold text-navy group-hover:text-accent transition-colors text-sm">{cat.name}</h3>
          <p class="text-xs text-slate mt-2 line-clamp-2">{cat.description}</p>
          <div class="flex flex-wrap gap-1.5 mt-3">
            {cat.subCategories.map(sc => (
              <span class="text-[10px] px-2 py-0.5 bg-navy/5 text-navy/70">{sc}</span>
            ))}
          </div>
          {cat.id === 'sleepwear' && (
            <div class="mt-3 text-[10px] text-accent font-medium uppercase tracking-wider">Custom Only · MOQ 300 pcs</div>
          )}
        </a>
      ))}
    </div>
    <div class="text-center mt-10">
      <a href="/products" class="btn-outline">View All Products →</a>
    </div>
  </section>

  <!-- Certifications -->
  <section class="bg-cream section-padding">
    <div class="container-site text-center">
      <span class="section-label">Certifications</span>
      <h2 class="section-title">Quality & Compliance</h2>
      <p class="section-desc mx-auto mb-10">We maintain globally recognized certifications to ensure every shipment meets international standards.</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6">
        {certifications.map(cert => (
          <div class="bg-white p-6 border border-gray-200">
            <div class="text-lg font-bold text-navy tracking-tight">{cert.name}</div>
            <div class="text-xs text-slate mt-2">{cert.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="container-site section-padding">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div>
        <span class="section-label">Why Choose Us</span>
        <h2 class="section-title">End-to-End Manufacturing<br />Under One Roof</h2>
        <ul class="mt-8 space-y-5">
          <li class="flex gap-4">
            <span class="text-accent font-bold text-lg mt-0.5">01</span>
            <div>
              <h3 class="font-semibold text-navy">Full OEM/ODM Service</h3>
              <p class="text-sm text-stone mt-1">From tech pack to bulk production. Pattern making, sample development, size grading.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="text-accent font-bold text-lg mt-0.5">02</span>
            <div>
              <h3 class="font-semibold text-navy">Certified Quality</h3>
              <p class="text-sm text-stone mt-1">BSCI & OEKO-TEX certified factory. Three-stage QC process (AQL 2.5).</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="text-accent font-bold text-lg mt-0.5">03</span>
            <div>
              <h3 class="font-semibold text-navy">Small Batch Available</h3>
              <p class="text-sm text-stone mt-1">Sampling through Viomisha.com. Evaluate quality before committing to bulk.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="text-accent font-bold text-lg mt-0.5">04</span>
            <div>
              <h3 class="font-semibold text-navy">Global Export Experience</h3>
              <p class="text-sm text-stone mt-1">Shipping to North America, Europe, Middle East & Southeast Asia. FCL/LCL.</p>
            </div>
          </li>
        </ul>
      </div>
      <div class="bg-cream-dark aspect-[4/5] flex items-center justify-center text-navy/20">
        <div class="p-8 text-center">
          <p class="text-navy/40 text-sm">Factory Image</p>
          <p class="text-xs text-navy/30 mt-2">5,000㎡ Modern Workshop</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-navy section-padding">
    <div class="container-site text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white">Ready to Start Your OEM Project?</h2>
      <p class="text-white/60 mt-4 max-w-lg mx-auto">Send us your tech pack or design reference. We'll respond within 24 hours with a detailed quote.</p>
      <div class="flex flex-wrap justify-center gap-4 mt-8">
        <a href="/contact" class="btn-accent px-8 py-4 font-semibold">Send Inquiry</a>
        <a href="https://viomisha.com" target="_blank" class="inline-flex items-center gap-2 border-2 border-white/30 text-white px-8 py-4 text-sm hover:bg-white/10 transition-colors">
          📦 Try Small Batch → Viomisha
        </a>
      </div>
    </div>
  </section>
</FactoryLayout>
