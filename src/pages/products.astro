---
// src/pages/products.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';

const allProducts = [
  { name: 'Lace Embrace Bralette', price: '48.00', category: 'Lingerie', href: '/products/lingerie/lace-embrace' },
  { name: 'Mesh Seduction Set', price: '72.00', category: 'Lingerie', href: '/products/lingerie/mesh-seduction' },
  { name: 'Tulle Romance Babydoll', price: '55.00', category: 'Lingerie', href: '/products/lingerie/tulle-romance' },
  { name: 'Satin Corset Top', price: '62.00', category: 'Lingerie', href: '/products/lingerie/satin-corset' },
  { name: 'Silk Dream Slip', price: '68.00', category: 'Sleepwear', href: '/products/sleepwear/silk-dream-slip' },
  { name: 'Satin Sleep Shorts', price: '38.00', category: 'Sleepwear', href: '/products/sleepwear/satin-shorts' },
  { name: 'Velvet Dressing Gown', price: '88.00', category: 'Sleepwear', href: '/products/sleepwear/velvet-gown' },
  { name: 'Cotton Modal Set', price: '45.00', category: 'Sleepwear', href: '/products/sleepwear/cotton-modal' },
];
---
<BaseLayout title="Shop All" description="Browse our complete collection of premium lingerie and sleepwear. Bras, bralettes, sets, nightgowns, and more.">
  <div class="container-site py-12">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 font-medium">All Products</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-display font-bold text-gray-900 mb-4">All Products</h1>
    <p class="text-gray-600 mb-10">Discover our full range of lingerie and sleepwear.</p>

    <div class="product-grid">
      {allProducts.map(product => (
        <ProductCard {...product} />
      ))}
    </div>
  </div>
</BaseLayout>
