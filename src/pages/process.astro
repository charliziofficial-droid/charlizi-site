---
import FactoryLayout from '../layouts/FactoryLayout.astro';
import { productionSteps } from '../data/products-b2b.js';
const title = "Lingerie Production Process | From Design to Delivery";
const description = "Our 7-step production process: pattern making, sample, fabric sourcing, cutting, sewing, QC, packaging. OEM/ODM intimate apparel manufacturing.";
---
<FactoryLayout title={title} description={description}>
  <div class="container-site py-12">
    <!-- Breadcrumb -->
    <nav class="breadcrumb">
      <a href="/">Home</a><span>/</span>
      <span class="text-navy font-medium">Production Process</span>
    </nav>

    <!-- Hero -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="section-label">Manufacturing</span>
      <h1 class="section-title text-balance">From Design to Delivery</h1>
      <p class="section-desc mx-auto">{description}</p>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line (desktop) -->
      <div class="hidden lg:block absolute left-1/2 top-0 bottom-0 w-0.5 bg-gray-200 -translate-x-1/2"></div>

      {productionSteps.map((step, index) => (
        <div class={`relative mb-12 lg:mb-20 ${index % 2 === 0 ? 'lg:pr-[55%]' : 'lg:pl-[55%] lg:text-right'}`}>
          <!-- Step number badge -->
          <div class="hidden lg:flex absolute left-1/2 top-0 -translate-x-1/2 w-14 h-14 bg-navy text-white rounded-full items-center justify-center font-bold text-lg z-10 shadow-md">
            {step.step}
          </div>

          <!-- Content card -->
          <div class={`card-hover p-6 md:p-8 rounded-lg ${index % 2 === 0 ? '' : 'lg:text-right'}`}>
            <!-- Mobile step badge -->
            <div class="lg:hidden flex items-center gap-3 mb-4">
              <span class="w-10 h-10 bg-navy text-white rounded-full flex items-center justify-center font-bold text-sm">{step.step}</span>
              <span class="text-xs text-accent font-medium uppercase tracking-wider">{step.duration}</span>
            </div>

            <h3 class="text-xl md:text-2xl font-bold text-navy">{step.title}</h3>

            <!-- Duration badge (desktop) -->
            <span class="hidden lg:inline-block mt-2 text-xs text-accent font-medium uppercase tracking-wider bg-accent/10 px-3 py-1 rounded">{step.duration}</span>

            <p class="text-stone mt-4 leading-relaxed">{step.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Total timeline summary -->
    <div class="bg-navy text-white rounded-lg p-8 mt-8 text-center">
      <p class="text-lg font-semibold">Total estimated timeline: <span class="text-accent-light">35-50 days</span> from sample approval to shipment</p>
      <p class="text-sm text-white/60 mt-2">Accelerated timelines available for repeat orders and bulk production runs.</p>
    </div>

    <!-- CTA -->
    <div class="flex flex-wrap gap-4 justify-center mt-12">
      <a href="/contact" class="btn-primary text-base px-8 py-4">📩 Start Your Project</a>
      <a href="/faq" class="btn-outline text-base px-8 py-4">OEM/ODM FAQ →</a>
    </div>
  </div>
</FactoryLayout>
