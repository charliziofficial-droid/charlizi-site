---
import PageLayout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { productCategories } from '~/data/b2b';

export async function getStaticPaths() {
  return productCategories.map(cat => ({
    params: { slug: cat.slug },
    props: { cat },
  }));
}

const { cat } = Astro.props;
const allOther = productCategories.filter(c => c.id !== cat.id);
---
<PageLayout
  metadata={{
    title: `${cat.name} Manufacturer | OEM ${cat.name} Wholesale China`,
    description: `Wholesale ${cat.name.toLowerCase()} manufacturer. ${cat.subCategories.slice(0, 3).join(', ')}. Custom OEM/ODM. ${cat.badge2}. MOQ ${cat.moq} pcs.`,
  }}
>
  <div class="container-site py-12">
    <nav class="text-xs text-stone/60 mb-8">
      <a href="/" class="hover:text-accent">Home</a>
      <span> / </span>
      <span class="text-navy font-medium">{cat.name}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
      <!-- Left: Info -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="bg-navy/10 text-navy font-medium text-xs px-2 py-0.5">{cat.badge1}</span>
          <span class="bg-accent/10 text-accent font-medium text-xs px-2 py-0.5">{cat.badge2}</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-navy mb-4">{cat.name}</h1>
        <p class="text-stone leading-relaxed mb-6">{cat.description}</p>

        <!-- Quick Specs -->
        <div class="grid grid-cols-2 gap-4 mb-8">
          <div class="p-4 bg-[#faf7f3] border border-gray-200">
            <div class="text-xs text-stone/60 uppercase tracking-wider">MOQ</div>
            <div class="text-lg font-bold text-navy">{cat.moq} pcs</div>
          </div>
          <div class="p-4 bg-[#faf7f3] border border-gray-200">
            <div class="text-xs text-stone/60 uppercase tracking-wider">Lead Time</div>
            <div class="text-lg font-bold text-navy">{cat.leadTime} days</div>
          </div>
        </div>

        <!-- Sub Categories -->
        <div class="mb-8">
          <h2 class="text-sm font-bold text-navy uppercase tracking-wider mb-3">Product Types</h2>
          <div class="flex flex-wrap gap-2">
            {cat.subCategories.map(sc => (
              <span class="text-xs px-3 py-1.5 bg-navy/5 text-navy">{sc}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: Specifications -->
      <div class="bg-[#faf7f3] p-8 border border-gray-200">
        <h2 class="text-lg font-bold text-navy mb-4">Specifications</h2>
        <ul class="space-y-3">
          {cat.specs.map(spec => (
            <li class="flex items-start gap-3 text-sm text-stone">
              <svg class="w-4 h-4 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span set:html={spec} />
            </li>
          ))}
        </ul>
        <a href="/contact" class="inline-block mt-8 w-full bg-[#b8865c] text-white text-center px-6 py-4 font-semibold hover:bg-[#d4a574] transition-colors">Inquire About {cat.name} →</a>
      </div>
    </div>

    <!-- Other Products -->
    <div class="mb-16">
      <h2 class="text-2xl font-bold text-navy mb-6">Other Products We Manufacture</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {allOther.map(p => (
          <a href={`/products/${p.slug}`} class="block p-4 bg-white border border-gray-200 hover:border-accent/30 text-center transition-all">
            <div class="text-sm font-bold text-navy">{p.name}</div>
            <div class="text-xs text-stone/60 mt-1">MOQ {p.moq}</div>
          </a>
        ))}
      </div>
    </div>

    <CallToAction
      title={`Need Custom ${cat.name}?`}
      subtitle={`Send us your requirements. We'll provide a quotation within 24 hours.`}
      callToAction={{
        text: 'Request a Quote',
        href: '/contact',
        variant: 'primary',
      }}
    />
  </div>
</PageLayout>
