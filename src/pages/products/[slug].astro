---
// src/pages/products/[slug].astro — Dynamic product detail pages
import FactoryLayout from '../../layouts/FactoryLayout.astro';
import { productCategories } from '../../data/products-b2b.js';

export async function getStaticPaths() {
  return productCategories.map(cat => ({
    params: { slug: cat.slug },
    props: { cat },
  }));
}

const { cat } = Astro.props;
const allOther = productCategories.filter(c => c.id !== cat.id);
const title = cat.metaTitle || `${cat.name} Manufacturer | OEM Wholesale`;
const description = cat.metaDesc || `Professional ${cat.name.toLowerCase()} manufacturer. Custom OEM/ODM. MOQ ${cat.id === 'sleepwear' ? '300' : '200'} pcs.`;
---
<FactoryLayout title={title} description={description}>
  <div class="container-site py-12">
    <!-- Breadcrumb -->
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/products">Products</a>
      <span>/</span>
      <span class="text-navy font-medium">{cat.name}</span>
    </nav>

    <!-- Main content -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start mb-16">
      <!-- Left: Info -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="badge-navy badge">OEM/ODM</span>
          <span class="badge-accent badge">BSCI & OEKO-TEX</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-navy mb-4">{cat.name}</h1>
        <p class="text-stone leading-relaxed mb-6">{cat.description}</p>

        <!-- Quick Specs -->
        <div class="grid grid-cols-2 gap-4 mb-8">
          <div class="p-4 bg-cream border border-gray-200">
            <div class="text-xs text-stone/60 uppercase tracking-wider">MOQ</div>
            <div class="text-lg font-bold text-navy">{cat.id === 'sleepwear' ? '300' : '200'} pcs</div>
          </div>
          <div class="p-4 bg-cream border border-gray-200">
            <div class="text-xs text-stone/60 uppercase tracking-wider">Lead Time</div>
            <div class="text-lg font-bold text-navy">30-45 days</div>
          </div>
        </div>

        <!-- Sub Categories -->
        <div class="mb-8">
          <h2 class="text-sm font-bold text-navy uppercase tracking-wider mb-3">Available Styles</h2>
          <div class="flex flex-wrap gap-2">
            {cat.subCategories.map(sc => (
              <span class="text-xs px-3 py-1.5 bg-navy/5 text-navy">{sc}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- Right: Specifications card -->
      <div class="bg-cream p-8 border border-gray-200 rounded-lg">
        <h2 class="text-lg font-bold text-navy mb-4">Specifications</h2>
        <ul class="space-y-3">
          {cat.specs.map(spec => (
            <li class="flex items-start gap-3 text-sm text-stone">
              <svg class="w-4 h-4 text-accent mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>{spec}</span>
            </li>
          ))}
        </ul>
        <a href="/contact" class="btn-accent w-full mt-8 text-center">Inquire About {cat.name} →</a>
      </div>
    </div>

    <!-- Other Products -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-navy mb-6">Other Products We Manufacture</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {allOther.map(p => (
          <a href={`/products/${p.slug}`} class="block p-4 bg-white border border-gray-200 hover:border-accent/30 text-center transition-all">
            <div class="text-sm font-bold text-navy">{p.name}</div>
            <div class="text-xs text-stone/60 mt-1">MOQ {p.id === 'sleepwear' ? '300' : '200'}</div>
          </a>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-cream rounded-lg p-8 md:p-12 text-center">
      <h2 class="text-xl font-bold text-navy">Need Custom {cat.name}?</h2>
      <p class="text-stone mt-3 max-w-lg mx-auto text-sm">Send us your requirements. We'll provide a quotation within 24 hours.</p>
      <div class="flex flex-wrap justify-center gap-4 mt-6">
        <a href="/contact" class="btn-primary">Send Inquiry</a>
        <a href="https://viomisha.com" target="_blank" class="btn-outline">📦 Small Batch Sample → Viomisha</a>
      </div>
    </section>
  </div>
</FactoryLayout>
