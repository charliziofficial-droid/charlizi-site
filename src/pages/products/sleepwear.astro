---
// src/pages/products/sleepwear.astro
import ProductLayout from '../../layouts/ProductLayout.astro';
import ProductCard from '../../components/ProductCard.astro';

const products = [
  { name: 'Silk Dream Slip', price: '68.00', category: 'Sleepwear', href: '/products/sleepwear/silk-dream-slip' },
  { name: 'Satin Sleep Shorts', price: '38.00', category: 'Sleepwear', href: '/products/sleepwear/satin-shorts' },
  { name: 'Velvet Dressing Gown', price: '88.00', category: 'Sleepwear', href: '/products/sleepwear/velvet-gown' },
  { name: 'Cotton Modal Set', price: '45.00', category: 'Sleepwear', href: '/products/sleepwear/cotton-modal' },
];
---
<ProductLayout title="Sleepwear Collection" description="Explore our sleepwear collection — silky slips, cozy sets, and luxurious robes. Crafted for comfort and elegance." category="Sleepwear">
  <h1 class="text-3xl md:text-4xl font-display font-bold text-gray-900 mb-4">Sleepwear</h1>
  <p class="text-gray-600 mb-10">From silky slips to cozy robes — sleepwear that feels as good as it looks.</p>

  <div class="product-grid">
    {products.map(product => (
      <ProductCard {...product} />
    ))}
  </div>
</ProductLayout>
