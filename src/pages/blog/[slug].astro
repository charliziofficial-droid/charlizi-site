---
// src/pages/blog/[slug].astro — Blog post detail pages
import FactoryLayout from '~/layouts/FactoryLayout.astro';
import { blogPosts } from '../../data/blog-posts.js';

export async function getStaticPaths() {
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---
<FactoryLayout title={post.title} description={post.desc}>
  <div class="container-site py-12">
    <!-- Breadcrumb -->
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/blog">Blog</a>
      <span>/</span>
      <span class="text-navy font-medium">{post.title}</span>
    </nav>

    <article class="max-w-3xl mx-auto">
      <time class="text-xs text-slate">{post.date}</time>
      <h1 class="text-3xl font-bold text-navy mb-6 mt-2">{post.title}</h1>
      <p class="text-stone leading-relaxed mb-6">{post.desc}</p>
      <div class="prose prose-sm max-w-none prose-headings:text-navy prose-a:text-accent">
        <p>This article is being developed. For immediate inquiries about {post.title.toLowerCase()}, please <a href="/contact">contact our team</a>.</p>
      </div>

      <div class="mt-12 pt-8 border-t border-gray-200">
        <a href="/blog" class="btn-outline">← Back to Blog</a>
      </div>
    </article>
  </div>
</FactoryLayout>
