---
// src/pages/blog.astro
import FactoryLayout from '../layouts/FactoryLayout.astro';
import { blogPosts } from '../data/blog-posts.js';
import Picture from '../components/Picture.astro';

const postsWithLinks = blogPosts.map(p => ({ ...p, href: `/blog/${p.slug}` }));
---
<FactoryLayout title="Blog | Intimate Apparel Manufacturing Insights" description="Industry insights on lingerie OEM/ODM manufacturing, quality certification, sourcing strategy, and production best practices.">
  <div class="container-site py-12">
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span class="text-navy font-medium">Blog</span>
    </nav>

    <div class="max-w-3xl mb-12">
      <span class="section-label">Manufacturing Insights</span>
      <h1 class="section-title">Blog & Resources</h1>
      <p class="section-desc">Industry knowledge on intimate apparel manufacturing, OEM/ODM sourcing, quality standards, and market trends.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {postsWithLinks.map(post => (
        <a href={post.href} class="card-hover group flex flex-col">
          <div class="aspect-[16/10] bg-cream-dark overflow-hidden">
            <Picture
              src={post.image}
              alt={post.title}
              sizes="(max-width: 640px) calc(100vw - 2rem), (max-width: 1024px) calc(50vw - 2.5rem), 384px"
              cls="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-6 flex flex-col flex-1">
            <time class="text-xs text-slate" datetime={post.date}>{post.date}</time>
            <h2 class="font-semibold text-navy mt-2 group-hover:text-accent transition-colors leading-snug">{post.title}</h2>
            <p class="text-xs text-stone mt-2 line-clamp-3 leading-relaxed">{post.desc}</p>
            <span class="inline-block mt-auto pt-4 text-xs text-accent font-medium group-hover:text-accent-dark transition-colors">Read More</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</FactoryLayout>
