---
// src/pages/blog.astro
import FactoryLayout from '../layouts/FactoryLayout.astro';

const blogPosts = [
  { title: 'How to Choose the Right Bra Manufacturer for Your Brand', date: '2026-06-01', desc: 'A practical guide for DTC brands looking for a reliable bra OEM partner — from MOQ considerations to quality certification requirements.', href: '/blog/choosing-bra-manufacturer' },
  { title: 'Understanding OEKO-TEX Certification in Intimate Apparel', date: '2026-05-25', desc: 'What OEKO-TEX Standard 100 means for lingerie production, and why it matters for your brand\'s compliance and customer trust.', href: '/blog/oeko-tex-certification' },
  { title: 'Bulk vs Small Batch: Sourcing Strategy for Apparel Brands', date: '2026-05-18', desc: 'When to start with small batch sampling and when to scale to full production. A strategic guide for intimate apparel brands.', href: '/blog/bulk-vs-small-batch' },
];
---
<FactoryLayout title="Blog | Intimate Apparel Manufacturing Insights" description="Industry insights on lingerie OEM/ODM manufacturing, quality certification, sourcing strategy, and production best practices.">
  <div class="container-site py-12">
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span class="text-navy font-medium">Blog</span>
    </nav>

    <div class="max-w-3xl mb-12">
      <span class="section-label">Manufacturing Insights</span>
      <h1 class="section-title">Blog & Resources</h1>
      <p class="section-desc">Industry knowledge on intimate apparel manufacturing, OEM/ODM sourcing, quality standards, and market trends.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {blogPosts.map(post => (
        <a href={post.href} class="card-hover group">
          <div class="aspect-[16/10] bg-cream-dark overflow-hidden">
            <div class="w-full h-full bg-gradient-to-br from-navy/[0.04] to-accent/[0.06] group-hover:scale-105 transition-transform duration-500"></div>
          </div>
          <div class="p-6">
            <time class="text-xs text-slate">{post.date}</time>
            <h2 class="font-semibold text-navy mt-2 group-hover:text-accent transition-colors">{post.title}</h2>
            <p class="text-sm text-stone mt-2 leading-relaxed">{post.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</FactoryLayout>
