---
// src/pages/catalog.astro — Product Catalog Browsing Page
import FactoryLayout from '../layouts/FactoryLayout.astro';
import { productCategories } from '../data/products-b2b.js';

const allProducts = productCategories.map(cat => ({
  ...cat,
  image: `/factory/images/${cat.slug}.svg`,
  specs: getCategorySpecs(cat.slug)
}));

function getCategorySpecs(slug) {
  const specs = {
    'bra-sets': ['MOQ: 200 pcs/style', 'Lead Time: 25-35 days', 'Fabrics: Lace, Mesh, Microfiber', 'Sizes: S-XXL, Custom', 'Packaging: Polybag + Hang Tag'],
    'bras': ['MOQ: 200 pcs/style', 'Lead Time: 20-30 days', 'Fabrics: Cotton, Nylon, Spandex', 'Sizes: 32A-38DD', 'Closures: 2/3 hook & eye'],
    'plus-size-bras': ['MOQ: 200 pcs/style', 'Lead Time: 25-35 days', 'Fabrics: Cotton, Nylon, Spandex, Lace', 'Sizes: 36C-46DD', 'Wide Straps: ✦ Standard'],
    'panties': ['MOQ: 300 pcs/style', 'Lead Time: 20-30 days', 'Styles: Bikini, Brief, Thong, Seamless', 'Sizes: XS-3XL', 'Fabric: Cotton, Modal, Nylon'],
    'silicone-bras': ['MOQ: 500 pcs/style', 'Lead Time: 25-35 days', 'Adhesive: Medical-grade silicone', 'Sizes: A-DDD', 'Colors: Nude, Black, White, Custom'],
    'shapewear': ['MOQ: 200 pcs/style', 'Lead Time: 25-35 days', 'Fabrics: Nylon/Spandex Power Mesh', 'Sizes: S-3XL', 'Compression: Light to Firm'],
    'sleepwear': ['MOQ: 300 pcs/style (Custom)', 'Lead Time: 30-45 days', 'Fabrics: Silk, Satin, Modal, Cotton', 'Sizes: S-2XL', 'Patterns: Pajama, Chemise, Robe, Nightgown']
  };
  return specs[slug] || ['MOQ: Contact us', 'Custom sizes available'];
}
---
<FactoryLayout
  title="Product Catalog | OEM Intimate Apparel Collection"
  description="Browse our complete product catalog with specifications. 7 categories including bras, panties, shapewear, silicone bras & sleepwear. B2B wholesale with OEM/ODM available."
>
  <div class="container-site py-12">
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/products">Products</a>
      <span>/</span>
      <span class="text-navy font-medium">Catalog</span>
    </nav>

    <div class="max-w-3xl mb-12">
      <span class="section-label">Product Catalog</span>
      <h1 class="section-title">Complete Product Collection</h1>
      <p class="section-desc">
        Browse our full product range with specifications. All categories available for
        OEM/ODM production with custom branding, packaging, and fabric options.
      </p>
    </div>

    <!-- Categories Grid -->
    <div class="space-y-16">
      {allProducts.map((cat, idx) => (
        <section id={cat.slug} class="scroll-mt-24">
          <div class="flex items-center gap-3 mb-6">
            <h2 class="text-2xl md:text-3xl font-bold text-navy">{cat.name}</h2>
            <span class="text-xs px-3 py-1 bg-accent/10 text-accent font-semibold rounded-full">
              {cat.subCategories.length} styles
            </span>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 bg-cream rounded-xl p-6 md:p-8">
            <!-- Image -->
            <div class="lg:col-span-2 bg-white rounded-lg overflow-hidden shadow-sm">
              <img
                src={cat.image}
                alt={cat.name}
                class="w-full h-64 lg:h-80 object-contain p-4"
                loading={idx === 0 ? 'eager' : 'lazy'}
              />
            </div>

            <!-- Info + Specs -->
            <div class="lg:col-span-3 space-y-5">
              <p class="text-stone text-sm leading-relaxed">{cat.description}</p>

              <!-- Sub-categories -->
              <div>
                <h3 class="text-xs font-semibold text-navy uppercase tracking-wider mb-2">Product Range</h3>
                <div class="flex flex-wrap gap-2">
                  {cat.subCategories.map(sc => (
                    <span class="text-xs px-3 py-1.5 bg-navy/5 text-navy/80 font-medium rounded">{sc}</span>
                  ))}
                </div>
              </div>

              <!-- Specs table -->
              <div>
                <h3 class="text-xs font-semibold text-navy uppercase tracking-wider mb-2">Specifications</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  {cat.specs.map(spec => {
                    const [key, ...valParts] = spec.split(': ');
                    const val = valParts.join(': ');
                    return (
                      <div class="bg-white px-4 py-2.5 rounded text-sm flex items-center gap-2 shadow-sm">
                        <span class="text-slate font-medium min-w-[70px]">{key}</span>
                        <span class="text-navy">{val}</span>
                      </div>
                    );
                  })}
                </div>
              </div>

              <!-- CTA -->
              <div class="flex flex-wrap gap-3 pt-2">
                <a href={`/products/${cat.slug}`} class="btn-navy text-sm px-5 py-2.5">
                  View Full Page →
                </a>
                <a href="/contact?product={cat.slug}" class="btn-outline text-sm px-5 py-2.5">
                  Request Quote
                </a>
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- Lead time note -->
    <div class="mt-16 bg-navy p-8 md:p-10 rounded-xl text-center">
      <h2 class="text-xl font-bold text-white">Ready to Start Your Project?</h2>
      <p class="text-white/70 mt-3 max-w-xl mx-auto text-sm">
        Send us your specifications, drawings, or samples for a customized quote.
        Sampling available for all categories.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mt-6">
        <a href="/contact" class="btn-accent text-sm px-8 py-3 font-semibold">Contact Sales</a>
        <a href="mailto:sales@charlizi.com" class="inline-flex items-center text-white/80 text-sm hover:text-white transition-colors gap-1">
          ✉ sales@charlizi.com
        </a>
      </div>
    </div>
  </div>
</FactoryLayout>
