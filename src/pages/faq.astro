---
import PageLayout from '~/layouts/PageLayout.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import { faqItems } from '~/data/b2b';
---
<PageLayout
  metadata={{
    title: 'FAQ | Lingerie OEM/ODM Manufacturing',
    description: 'Frequently asked questions about our lingerie OEM/ODM manufacturing process, MOQ, lead times, certifications, sampling, and shipping.',
  }}
>
  <div class="container-site py-12">
    <nav class="text-xs text-stone/60 mb-8">
      <a href="/" class="hover:text-accent">Home</a>
      <span> / </span>
      <span class="text-navy font-medium">FAQ</span>
    </nav>

    <div class="max-w-2xl mb-10">
      <span class="text-xs font-semibold tracking-[0.2em] uppercase text-accent">FAQ</span>
      <h1 class="text-3xl md:text-4xl font-bold text-navy mt-3 mb-4">Frequently Asked Questions</h1>
      <p class="text-stone leading-relaxed">Everything you need to know about working with Charlizi Factory. If you have more questions, <a href="/contact" class="text-accent underline">contact us</a>.</p>
    </div>

    <div class="max-w-3xl space-y-4">
      {faqItems.map(item => (
        <details class="group bg-white border border-gray-200 [&[open]]:border-accent/30 transition-colors">
          <summary class="flex items-center justify-between p-5 cursor-pointer list-none">
            <span class="text-sm font-semibold text-navy group-open:text-accent pr-4">{item.q}</span>
            <svg class="w-4 h-4 text-stone shrink-0 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-5 pb-5 text-sm text-stone leading-relaxed" set:html={item.a} />
        </details>
      ))}
    </div>
  </div>
</PageLayout>
