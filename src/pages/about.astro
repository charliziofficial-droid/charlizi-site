---
// src/pages/about.astro
import FactoryLayout from '../layouts/FactoryLayout.astro';
import { factoryStats, certifications } from '../data/products-b2b.js';
import Picture from '../components/Picture.astro';
---
<FactoryLayout
  title="About Charlizi Factory | Lingerie OEM Manufacturer"
  description="Learn about Charlizi Factory - 5,000sqm intimate apparel manufacturing facility. 200+ workers, BSCI/OEKO-TEX certified. Custom OEM/ODM with pattern development."
>
  <div class="container-site py-12">
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <span class="text-navy font-medium">About</span>
    </nav>

    <div class="max-w-3xl mb-16">
      <span class="section-label">About Us</span>
      <h1 class="section-title">Your Partner in Intimate Apparel Manufacturing</h1>
      <p class="section-desc">
        Charlizi Factory was founded in {factoryStats.founded} with a mission to provide
        global brands with high-quality, ethically produced intimate apparel at competitive prices.
      </p>
    </div>

    <!-- Overview: full-width photo, copy underneath -->
    <div class="mb-20">
      <figure class="overflow-hidden rounded-xl shadow-md">
        <Picture
          src="charlizi-factory.webp"
          alt="Charlizi Factory workshop floor in Puning, Guangdong, with sewing lines producing intimate apparel"
          sizes="(max-width: 640px) calc(100vw - 2rem), (max-width: 1024px) calc(100vw - 3rem), 1216px"
          cls="w-full h-auto"
          loading="eager"
          priority
        />
      </figure>

      <div class="mt-10 grid md:grid-cols-3 gap-10">
        <div class="md:col-span-2">
          <h2 class="text-2xl font-bold text-navy">Factory Overview</h2>
          <p class="text-stone mt-4 leading-relaxed">
            Located in Puning, Guangdong - the heart of China's apparel manufacturing industry -
            our {factoryStats.area} facility houses {factoryStats.workers} skilled workers
            producing over {factoryStats.annualOutput} garments annually.
          </p>
          <p class="text-stone mt-4 leading-relaxed">
            We specialize in bras, bra sets, panties, plus size lingerie, silicone bras, shapewear,
            and custom sleepwear development. Our clients range from emerging DTC brands to
            established retailers across North America, Europe, the Middle East, and Southeast Asia.
          </p>
        </div>

        <dl class="grid grid-cols-3 md:grid-cols-1 gap-4 self-start md:border-l md:border-gray-200 md:pl-8">
          <div>
            <dt class="text-xs text-slate uppercase tracking-wider">Workshop</dt>
            <dd class="text-2xl font-bold text-navy mt-1">{factoryStats.area}</dd>
          </div>
          <div>
            <dt class="text-xs text-slate uppercase tracking-wider">Staff</dt>
            <dd class="text-2xl font-bold text-navy mt-1">{factoryStats.workers}</dd>
          </div>
          <div>
            <dt class="text-xs text-slate uppercase tracking-wider">Annual Output</dt>
            <dd class="text-2xl font-bold text-navy mt-1">{factoryStats.annualOutput}</dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Team -->
    <div class="mb-20">
      <h2 class="text-2xl font-bold text-navy mb-2">Our Team</h2>
      <p class="text-stone mb-8 max-w-2xl">
        From pattern engineers to quality inspectors, every team member plays a role
        in delivering consistent, high-quality products.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { role: 'Pattern Engineers', desc: 'CAD pattern making and grading', count: '8' },
          { role: 'Sample Makers', desc: 'First samples and fit approval', count: '12' },
          { role: 'Production Workers', desc: 'Dedicated sewing lines', count: '160+' },
          { role: 'QC Inspectors', desc: '3-stage quality control', count: '15' },
          { role: 'Merchandising & Logistics', desc: 'Order follow-up and export docs', count: '12' },
        ].map(t => (
          <div class="card p-6">
            <div class="text-2xl font-bold text-accent">{t.count}</div>
            <h3 class="font-semibold text-navy mt-2">{t.role}</h3>
            <p class="text-xs text-stone mt-1">{t.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-xs text-slate mt-4">Team headcount across pattern, sampling, production, QC and merchandising totals 200+.</p>
    </div>

    <!-- Custom Sampling -->
    <div class="mb-20 bg-cream p-8 md:p-12">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          <h2 class="text-2xl font-bold text-navy">Custom Sampling and Development</h2>
          <p class="text-stone mt-4 leading-relaxed">
            Have a design in mind? We handle the full development cycle:
          </p>
          <ul class="mt-6 space-y-3 text-sm text-stone">
            <li class="flex gap-3">
              <span class="text-accent font-bold">01</span>
              <span><strong class="text-navy">Tech Pack Review</strong> - We review your spec sheet and suggest material and cost optimizations</span>
            </li>
            <li class="flex gap-3">
              <span class="text-accent font-bold">02</span>
              <span><strong class="text-navy">Pattern Making</strong> - Digital pattern creation with graded size sets</span>
            </li>
            <li class="flex gap-3">
              <span class="text-accent font-bold">03</span>
              <span><strong class="text-navy">Sample Development</strong> - First sample in 7-10 days, revisions included</span>
            </li>
            <li class="flex gap-3">
              <span class="text-accent font-bold">04</span>
              <span><strong class="text-navy">Bulk Production</strong> - Once approved, full production with QC tracking</span>
            </li>
          </ul>
        </div>
        <div class="text-center">
          <p class="text-navy/50 text-sm">Need a quick sample run?</p>
          <a href="https://viomisha.com" target="_blank" class="btn-accent mt-4 inline-flex gap-2">Shop Samples on Viomisha</a>
        </div>
      </div>
    </div>

    <!-- Certifications -->
    <div>
      <h2 class="text-2xl font-bold text-navy mb-8">Certifications</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {certifications.map(cert => (
          <div class="card p-5 text-center">
            <div class="text-lg font-bold text-navy">{cert.name}</div>
            <div class="text-xs text-slate mt-2">{cert.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</FactoryLayout>
