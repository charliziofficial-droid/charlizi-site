---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Our Story" description="Discover the story behind Charlizi — a premium lingerie and sleepwear brand designed for confidence, comfort, and timeless elegance.">
  <div class="container-site py-12 max-w-3xl">
    <nav class="text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 font-medium">Our Story</span>
    </nav>

    <h1 class="text-3xl md:text-4xl font-display font-bold text-gray-900 mb-6">Our Story</h1>
    
    <div class="prose prose-lg text-gray-700 space-y-6">
      <p>
        Charlizi was born from a simple belief: <strong>every woman deserves to feel beautiful</strong> — 
        not just on special occasions, but every single day.
      </p>
      <p>
        We design premium lingerie and sleepwear that blend timeless elegance with modern comfort. 
        Every piece is thoughtfully crafted from the finest materials — soft laces, silky satins, and breathable cottons — 
        ensuring you feel as good as you look.
      </p>
      <p>
        From our signature bralettes to our dreamy sleep slips, each design is created with attention to detail, 
        fit, and durability. We believe that the best intimates are the ones you forget you're wearing — 
        until someone reminds you how amazing you look.
      </p>
      <p class="font-display text-xl text-brand-700 mt-8">
        — The Charlizi Team
      </p>
    </div>
  </div>
</BaseLayout>
