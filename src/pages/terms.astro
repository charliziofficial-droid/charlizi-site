---
import FactoryLayout from '~/layouts/FactoryLayout.astro';
---
<FactoryLayout title="Terms of Service | Charlizi Factory" description="Terms of service for Charlizi Factory." noindex={true}>
  <div class="container-site py-12 max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold text-navy mb-8">Terms of Service</h1>
    <div class="prose prose-sm prose-headings:text-navy">
      <p><em>Last updated: June 2026</em></p>
      <h2>General</h2>
      <p>These terms govern the use of the Charlizi Factory website and the services we provide as an OEM/ODM manufacturer.</p>
      <h2>Quotations & Orders</h2>
      <p>All quotations are valid for 15 days from the date of issue. Orders are confirmed upon receipt of deposit payment as specified in the quotation.</p>
      <h2>Intellectual Property</h2>
      <p>Customer designs and tech packs remain the intellectual property of the customer. Charlizi Factory will not reproduce or share customer designs without express written permission.</p>
      <h2>Contact</h2>
      <p>For questions about these terms, email <a href="mailto:sales@charlizi.com" class="text-accent">sales@charlizi.com</a>.</p>
    </div>
  </div>
</FactoryLayout>
