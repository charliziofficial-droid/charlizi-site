---
import FactoryLayout from '../layouts/FactoryLayout.astro';
import { productCategories } from '../data/products-b2b.js';
const title = "Contact Charlizi Factory | Lingerie OEM/ODM Inquiry";
const description = "Get in touch with Charlizi Factory. OEM/ODM inquiries, sampling requests, factory visits. We respond within 24 hours.";
const quantityOptions = [
  '200-500 pcs',
  '500-1,000 pcs',
  '1,000-3,000 pcs',
  '3,000-10,000 pcs',
  '10,000+ pcs',
  'Not sure yet',
];
const marketOptions = [
  'North America',
  'Europe',
  'Middle East',
  'Southeast Asia',
  'South America',
  'Australia / Oceania',
  'Africa',
  'Global / Multi-region',
];
const categoryOptions = productCategories.map(c => c.name);
// Preferred payment method (customer profile dimension)
const paymentOptions = [
  'T/T (Bank Transfer)',
  'PayPal',
  'Credit Card',
  'Alibaba Trade Assurance',
  'Western Union',
  'Not Sure Yet',
  'Other',
];
// How the customer found us — value => display label
const sourceOptions = [
  { value: 'Google Search', label: 'Google Search' },
  { value: 'Alibaba / Made-in-China', label: 'Alibaba / Made-in-China' },
  { value: 'Social Media', label: 'Social Media (Instagram / TikTok / Facebook…)' },
  { value: 'Referral', label: 'Referral from a partner or customer' },
  { value: 'Trade Show / Exhibition', label: 'Trade Show / Exhibition' },
  { value: 'AI / ChatGPT', label: 'AI Chat (ChatGPT, Gemini, etc.)' },
  { value: 'Other', label: 'Other' },
];
---
<FactoryLayout title={title} description={description}>
  <div class="container-site py-12">
    <!-- Breadcrumb -->
    <nav class="breadcrumb">
      <a href="/">Home</a><span>/</span>
      <span class="text-navy font-medium">Contact</span>
    </nav>

    <!-- Hero -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="section-label">Get in Touch</span>
      <h1 class="section-title text-balance">Start Your OEM/ODM Project</h1>
      <p class="section-desc mx-auto">Fill out the form below and our team will respond within <strong>24 hours</strong>. For urgent inquiries, reach us directly via WhatsApp or WeChat.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
      <!-- Form -->
      <div class="lg:col-span-3">
        <form id="inquiry-form" action="/api/inquiry" method="POST" class="card p-8 rounded-lg">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Full Name -->
            <div>
              <label for="name" class="block text-sm font-medium text-navy mb-1">Full Name <span class="text-red-400">*</span></label>
              <input type="text" id="name" name="name" required
                class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm" />
            </div>
            <!-- Company Name -->
            <div>
              <label for="company" class="block text-sm font-medium text-navy mb-1">Company Name <span class="text-red-400">*</span></label>
              <input type="text" id="company" name="company" required
                class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm" />
            </div>
            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-medium text-navy mb-1">Email Address <span class="text-red-400">*</span></label>
              <input type="email" id="email" name="email" required
                class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm" />
            </div>
            <!-- WhatsApp/Phone -->
            <div>
              <label for="phone" class="block text-sm font-medium text-navy mb-1">WhatsApp / Phone</label>
              <input type="tel" id="phone" name="phone"
                class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm" placeholder="Include country code" />
            </div>
            <!-- Product Category -->
            <div>
              <label for="category" class="block text-sm font-medium text-navy mb-1">Product Category <span class="text-red-400">*</span></label>
              <select id="category" name="category" required
                class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm bg-white">
                <option value="">Select category...</option>
                {categoryOptions.map(cat => (
                  <option value={cat}>{cat}</option>
                ))}
              </select>
            </div>
            <!-- Quantity Estimate -->
            <div>
              <label for="quantity" class="block text-sm font-medium text-navy mb-1">Quantity Estimate <span class="text-red-400">*</span></label>
              <select id="quantity" name="quantity" required
                class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm bg-white">
                <option value="">Select quantity...</option>
                {quantityOptions.map(q => (
                  <option value={q}>{q}</option>
                ))}
              </select>
            </div>
            <!-- Target Market -->
            <div>
              <label for="market" class="block text-sm font-medium text-navy mb-1">Target Market</label>
              <select id="market" name="market"
                class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm bg-white">
                <option value="">Select market...</option>
                {marketOptions.map(m => (
                  <option value={m}>{m}</option>
                ))}
              </select>
            </div>
            <!-- Preferred Payment Method -->
            <div>
              <label for="payment_method" class="block text-sm font-medium text-navy mb-1">Preferred Payment Method <span class="text-stone/50 font-normal">(optional)</span></label>
              <select id="payment_method" name="payment_method"
                class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm bg-white">
                <option value="">Select payment method...</option>
                {paymentOptions.map(p => (
                  <option value={p}>{p}</option>
                ))}
              </select>
              <div id="payment_other_wrap" class="hidden mt-2">
                <input type="text" id="payment_other" name="payment_method_detail" maxlength="80"
                  class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm"
                  placeholder="Please specify your payment method" />
              </div>
            </div>
            <!-- Message -->
            <div class="md:col-span-2">
              <label for="message" class="block text-sm font-medium text-navy mb-1">Message Details <span class="text-red-400">*</span></label>
              <textarea id="message" name="message" rows="5" required
                class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm resize-y"
                placeholder="Describe your product requirements — style, fabric, size range, target price, or attach a tech pack..."></textarea>
            </div>
            <!-- File attach hint -->
            <div class="md:col-span-2">
              <p class="text-xs text-stone/70 flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg>
                Attach files (tech pack, sketches, reference images) — we'll follow up via email to receive attachments securely.
              </p>
            </div>
            <!-- How Did You Find Us -->
            <div class="md:col-span-2">
              <label for="source" class="block text-sm font-medium text-navy mb-1">How Did You Find Us? <span class="text-stone/50 font-normal">(optional)</span></label>
              <select id="source" name="source"
                class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm bg-white">
                <option value="">Select an option...</option>
                {sourceOptions.map(s => (
                  <option value={s.value}>{s.label}</option>
                ))}
              </select>
              <div id="source_other_wrap" class="hidden mt-2">
                <input type="text" id="source_other" name="source_detail" maxlength="80"
                  class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm"
                  placeholder="Where did you hear about us?" />
              </div>
            </div>
            <!-- Auto-captured attribution (hidden) -->
            <input type="hidden" id="ref_referrer" name="ref_referrer" value="" />
            <input type="hidden" id="ref_landing" name="ref_landing" value="" />
            <input type="hidden" id="ref_utm" name="ref_utm" value="" />
          </div>

          <button type="submit" class="btn-primary w-full mt-6 text-base py-4 inline-flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Send Inquiry
          </button>
          <p class="text-xs text-stone/50 text-center mt-3">We respect your privacy. Your information will never be shared.</p>
        </form>

        <!-- Success state -->
        <div id="inquiry-success" class="hidden card p-8 rounded-lg text-center">
          <div class="mx-auto w-14 h-14 rounded-full bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-navy mb-2">Inquiry received</h3>
          <p class="text-sm text-stone leading-relaxed max-w-md mx-auto">
            Thank you — we've got your request and our team will reply to your email within 24 hours.
            Need to add something? Just reply to our email or message us on WhatsApp.
          </p>
        </div>

        <!-- Error state -->
        <div id="inquiry-error" class="hidden card p-6 rounded-lg">
          <p class="text-sm text-red-600">
            Something went wrong while sending your inquiry. Please try again, or email us directly at
            <a href="mailto:charlizi.official@gmail.com" class="underline font-medium">charlizi.official@gmail.com</a>.
          </p>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Direct Contact -->
        <div class="card p-6 rounded-lg">
          <h3 class="text-sm font-semibold text-navy uppercase tracking-wider mb-4">Direct Contact</h3>
          <div class="space-y-4">
            <div>
              <p class="text-xs text-stone uppercase tracking-wider">WhatsApp</p>
              <a href="https://wa.me/8613352743559" target="_blank" class="text-navy font-medium hover:text-accent transition-colors">+86 133 5274 3559</a>
            </div>
            <div>
              <p class="text-xs text-stone uppercase tracking-wider">WeChat</p>
              <p class="text-navy font-medium">ke_666889</p>
            </div>
            <div>
              <p class="text-xs text-stone uppercase tracking-wider">Email</p>
              <a href="mailto:charlizi.official@gmail.com" class="text-navy font-medium hover:text-accent transition-colors">charlizi.official@gmail.com</a>
            </div>
          </div>
        </div>

        <!-- Address -->
        <div class="card p-6 rounded-lg">
          <h3 class="text-sm font-semibold text-navy uppercase tracking-wider mb-4">Factory Address</h3>
          <p class="text-sm text-stone leading-relaxed">
            Charlizi Intimate Apparel Co., Ltd.<br />
            Shiqiaotou Industry District No.102<br />
            Junbu Town, Puning City<br />
            Guangdong Province<br />
            China
          </p>
          <p class="text-xs text-stone/60 mt-3">Factory visits welcome by appointment. Located in Puning, Guangdong — the global hub for lingerie and apparel manufacturing.</p>
        </div>

        <!-- Viomisha -->
        <div class="bg-cream rounded-lg p-6">
          <div class="flex items-start gap-3">
            <span class="text-2xl">📦</span>
            <div>
              <h3 class="text-sm font-semibold text-navy">Need Small Quantities?</h3>
              <p class="text-sm text-stone mt-1">Visit <a href="https://viomisha.com" target="_blank" class="text-accent font-medium hover:underline">Viomisha.com</a> for small batch sampling, inventory testing, or retail quantities.</p>
              <a href="https://viomisha.com" target="_blank" class="inline-block mt-3 btn-outline text-xs py-2 px-4">Visit Viomisha ↗</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // --- "Other" free-text reveal for Payment Method & Source ---
    function bindOtherToggle(selectId, wrapId, inputId) {
      const sel = document.getElementById(selectId);
      const wrap = document.getElementById(wrapId);
      const input = document.getElementById(inputId);
      if (!sel || !wrap || !input) return;
      const sync = () => {
        const isOther = sel.value === 'Other';
        wrap.classList.toggle('hidden', !isOther);
        if (isOther) {
          input.focus({ preventScroll: true });
        } else {
          input.value = '';
        }
      };
      sel.addEventListener('change', sync);
      sync();
    }
    bindOtherToggle('payment_method', 'payment_other_wrap', 'payment_other');
    bindOtherToggle('source', 'source_other_wrap', 'source_other');

    // --- Auto-capture attribution (referrer + UTM) ---
    (function captureAttribution() {
      const refEl = document.getElementById('ref_referrer');
      const landEl = document.getElementById('ref_landing');
      const utmEl = document.getElementById('ref_utm');
      if (!refEl || !landEl || !utmEl) return;

      // Remember the original landing page across internal navigation
      let landing = '';
      try {
        landing = sessionStorage.getItem('cz_landing') || '';
        if (!landing) {
          landing = document.referrer || location.href;
          sessionStorage.setItem('cz_landing', landing);
        }
      } catch (e) {
        landing = document.referrer || location.href;
      }
      refEl.value = document.referrer || 'direct';
      landEl.value = landing;

      // Collect UTM / click-id params from this visit or the remembered landing URL
      const keys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'gclid', 'fbclid', 'msclkid'];
      const params = new URLSearchParams(location.search);
      let landingParams;
      try {
        landingParams = new URLSearchParams(new URL(landing).search);
      } catch (e) {
        landingParams = new URLSearchParams();
      }
      const found = [];
      keys.forEach((k) => {
        const v = params.get(k) || landingParams.get(k);
        if (v) found.push(`${k}=${v}`);
      });
      utmEl.value = found.length ? found.join(' | ') : 'none';
    })();

    // --- AJAX submit: keep customer on page, show explicit success state ---
    (function bindSubmit() {
      const form = document.getElementById('inquiry-form');
      const successEl = document.getElementById('inquiry-success');
      const errorEl = document.getElementById('inquiry-error');
      const btn = form ? form.querySelector('button[type="submit"]') : null;
      if (!form || !successEl || !errorEl || !btn) return;

      let sending = false;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (sending) return;
        sending = true;

        const originalLabel = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = 'Sending...';
        errorEl.classList.add('hidden');

        try {
          const body = new FormData(form);
          const res = await fetch(form.action, {
            method: 'POST',
            body,
            headers: { Accept: 'application/json' },
          });
          let data = {};
          try {
            data = await res.json();
          } catch {}

          if (res.ok && data.ok) {
            form.classList.add('hidden');
            successEl.classList.remove('hidden');
            successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            throw new Error(data.error || 'submit_failed');
          }
        } catch (err) {
          errorEl.classList.remove('hidden');
          errorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          btn.disabled = false;
          btn.innerHTML = originalLabel;
        } finally {
          sending = false;
        }
      });
    })();
  </script>
</FactoryLayout>
