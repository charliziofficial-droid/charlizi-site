---
import PageLayout from '~/layouts/PageLayout.astro';
import { productCategories } from '~/data/b2b';
---
<PageLayout
  metadata={{
    title: 'Contact Charlizi Factory | Lingerie OEM/ODM Inquiry',
    description: 'Get in touch with Charlizi Factory. OEM/ODM inquiries, sampling requests, factory visits. We respond within 24 hours.',
  }}
>
  <div class="container-site py-12">
    <nav class="text-xs text-stone/60 mb-8">
      <a href="/" class="hover:text-accent">Home</a>
      <span> / </span>
      <span class="text-navy font-medium">Contact</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
      <!-- Sidebar Info -->
      <div class="lg:col-span-2">
        <span class="text-xs font-semibold tracking-[0.2em] uppercase text-accent">Contact Us</span>
        <h1 class="text-3xl md:text-4xl font-bold text-navy mt-3 mb-6">Get a Quote</h1>
        <p class="text-stone leading-relaxed mb-8">Fill out the form and we'll respond within <strong>24 hours</strong> with a quotation and next steps.</p>

        <!-- Quick Contact Info -->
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-navy/5 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <div class="font-semibold text-navy">Email</div>
              <a href="mailto:sales@charlizi.com" class="text-sm text-stone hover:text-accent">sales@charlizi.com</a>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-navy/5 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <div>
              <div class="font-semibold text-navy">WhatsApp</div>
              <a href="https://wa.me/8613632856817" class="text-sm text-stone hover:text-accent">+86 136 3285 6817</a>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-navy/5 rounded-full flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <div class="font-semibold text-navy">Address</div>
              <div class="text-sm text-stone">Buji Street, Longgang District<br/>Shenzhen, China</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="lg:col-span-3">
        <form method="POST" action="/api/contact" class="bg-white p-8 border border-gray-200">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-medium text-navy mb-1">Your Name <span class="text-red-400">*</span></label>
              <input type="text" id="name" name="name" required class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm" placeholder="John Smith" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-navy mb-1">Email <span class="text-red-400">*</span></label>
              <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm" placeholder="john@example.com" />
            </div>
            <div>
              <label for="company" class="block text-sm font-medium text-navy mb-1">Company</label>
              <input type="text" id="company" name="company" class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm" placeholder="Your Brand LLC" />
            </div>
            <div>
              <label for="country" class="block text-sm font-medium text-navy mb-1">Country / Market</label>
              <input type="text" id="country" name="country" class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm" placeholder="North America, Europe..." />
            </div>
            <div>
              <label for="product" class="block text-sm font-medium text-navy mb-1">Product Interest <span class="text-red-400">*</span></label>
              <select id="product" name="product" required class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm bg-white">
                <option value="">Select product type...</option>
                {productCategories.map(cat => (
                  <option value={cat.slug}>{cat.name}</option>
                ))}
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label for="quantity" class="block text-sm font-medium text-navy mb-1">Estimated Quantity <span class="text-red-400">*</span></label>
              <select id="quantity" name="quantity" required class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm bg-white">
                <option value="">Select quantity...</option>
                <option>200-500 pcs</option>
                <option>500-1,000 pcs</option>
                <option>1,000-3,000 pcs</option>
                <option>3,000-10,000 pcs</option>
                <option>10,000+ pcs</option>
                <option>Not sure yet</option>
              </select>
            </div>
            <div class="md:col-span-2">
              <label for="message" class="block text-sm font-medium text-navy mb-1">Message Details <span class="text-red-400">*</span></label>
              <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:border-accent transition-colors text-sm resize-y" placeholder="Describe your product requirements — style, fabric, size range, target price, or attach a tech pack..."></textarea>
            </div>
          </div>
          <div class="mt-6">
            <button type="submit" class="w-full bg-accent text-white px-8 py-4 font-semibold hover:bg-accent-light transition-colors text-sm">Send Inquiry →</button>
          </div>
          <p class="text-xs text-stone/60 mt-3 text-center">We respect your privacy. Your information will not be shared.</p>
        </form>
      </div>
    </div>
  </div>
</PageLayout>
