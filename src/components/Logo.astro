---
import { SITE } from 'astrowind:config';
---

<a href="/" class="flex items-center gap-2">
  <span class="w-8 h-8 bg-navy rounded flex items-center justify-center">
    <svg viewBox="0 0 24 24" class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 3c-1 0-3 2-3 4s2 3 4 3 3-1 3-3-2-4-4-4z"/>
      <path d="M4 21c0-4 4-8 8-8s8 4 8 8"/>
    </svg>
  </span>
  <div class="flex flex-col">
    <span class="text-sm font-bold text-navy leading-tight">{SITE?.name || 'Charlizi'}</span>
    <span class="text-[10px] text-accent tracking-[0.2em] uppercase leading-tight">Factory Direct</span>
  </div>
</a>
