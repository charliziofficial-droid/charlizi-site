---
// src/components/FeaturedProducts.astro
import ProductCard from './ProductCard.astro';

// Placeholder products — will be replaced with CMS content later
const featuredProducts = [
  { name: 'Lace Embrace Bralette', price: '48.00', category: 'Lingerie', href: '/products/lingerie/lace-embrace' },
  { name: 'Silk Dream Slip', price: '68.00', category: 'Sleepwear', href: '/products/sleepwear/silk-dream-slip' },
  { name: 'Mesh Seduction Set', price: '72.00', category: 'Lingerie', href: '/products/lingerie/mesh-seduction' },
  { name: 'Satin Sleep Shorts', price: '38.00', category: 'Sleepwear', href: '/products/sleepwear/satin-shorts' },
];
---
<section class="container-site py-16 md:py-24">
  <div class="text-center mb-12">
    <span class="text-sm uppercase tracking-[0.2em] text-brand-600 font-medium">The Collection</span>
    <h2 class="text-3xl md:text-4xl font-display font-bold text-gray-900 mt-3">Bestsellers</h2>
    <p class="text-gray-600 mt-4 max-w-lg mx-auto">
      Curated favorites, loved by our customers for their fit, feel, and timeless design.
    </p>
  </div>

  <div class="product-grid">
    {featuredProducts.map(product => (
      <ProductCard {...product} />
    ))}
  </div>

  <div class="text-center mt-10">
    <a href="/products" class="btn-outline">View All Products →</a>
  </div>
</section>
