---
import '@fontsource-variable/inter';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* Charlizi Factory Brand Colors */
    --aw-color-primary: rgb(26 37 64);     /* navy #1a2540 */
    --aw-color-secondary: rgb(184 134 92); /* accent/warm gold #b8865c */
    --aw-color-accent: rgb(184 134 92);    /* accent #b8865c */

    --aw-color-text-heading: rgb(26 37 64);
    --aw-color-text-default: rgb(120 113 108);
    --aw-color-text-muted: rgb(120 113 108 / 66%);
    --aw-color-bg-page: rgb(250 247 243);  /* cream #faf7f3 */

    --aw-color-bg-page-dark: rgb(15 23 41);

    ::selection {
      background-color: rgb(184 134 92 / 30%);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(184 134 92);
    --aw-color-secondary: rgb(26 37 64);
    --aw-color-accent: rgb(184 134 92);

    --aw-color-text-heading: rgb(247 248 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(15 23 41);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
