---
// src/components/Hero.astro
---
<section class="relative bg-gradient-to-b from-blush to-cream overflow-hidden min-h-[70vh] flex items-center">
  <div class="container-site py-16 md:py-24">
    <div class="max-w-2xl">
      <span class="text-sm uppercase tracking-[0.2em] text-brand-600 font-medium">Premium Lingerie & Sleepwear</span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-display font-bold text-gray-900 mt-4 leading-tight">
        Confidence<br />
        <span class="text-brand-600">Feels Like</span> This
      </h1>
      <p class="text-gray-600 text-base sm:text-lg mt-6 max-w-lg leading-relaxed">
        Thoughtfully designed intimates crafted from premium materials — 
        because you deserve to feel beautiful from the inside out.
      </p>
      <div class="flex flex-wrap gap-4 mt-8">
        <a href="/products" class="btn-primary text-base px-8 py-4">
          Shop the Collection
        </a>
        <a href="/about" class="btn-outline text-base px-8 py-4">
          Our Story
        </a>
      </div>
    </div>
  </div>
  
  <!-- Decorative element -->
  <div class="absolute right-0 top-0 w-1/3 h-full bg-gradient-to-l from-brand-100/30 to-transparent hidden lg:block"></div>
</section>
