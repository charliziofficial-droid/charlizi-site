---
// src/components/CategoryGrid.astro
---
<section class="bg-cream py-16 md:py-24">
  <div class="container-site">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-gray-900">Shop by Category</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      <!-- Lingerie -->
      <a href="/products/lingerie" class="group relative overflow-hidden rounded-xl aspect-[4/3] md:aspect-[3/2] bg-gradient-to-br from-brand-100 to-brand-200">
        <div class="absolute inset-0 bg-black/20 group-hover:bg-black/30 transition-colors"></div>
        <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
          <h3 class="text-white text-2xl md:text-3xl font-display font-bold">Lingerie</h3>
          <p class="text-white/80 text-sm mt-1">Bras, bralettes, sets & more</p>
        </div>
      </a>
      
      <!-- Sleepwear -->
      <a href="/products/sleepwear" class="group relative overflow-hidden rounded-xl aspect-[4/3] md:aspect-[3/2] bg-gradient-to-br from-brand-300 to-brand-500">
        <div class="absolute inset-0 bg-black/20 group-hover:bg-black/30 transition-colors"></div>
        <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
          <h3 class="text-white text-2xl md:text-3xl font-display font-bold">Sleepwear</h3>
          <p class="text-white/80 text-sm mt-1">Nightgowns, slips, robes & more</p>
        </div>
      </a>
    </div>
  </div>
</section>
