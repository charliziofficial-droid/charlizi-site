---
// src/components/BlogSchema.astro
// Renders the per-article JSON-LD graph (Article + FAQPage + BreadcrumbList)
// and the visible FAQ block that the FAQPage schema describes.
//
// Separating the visible FAQ from the layout keeps a single source of truth:
// src/data/blog-schema.ts.
import { buildBlogSchemaGraph, type BlogSchemaEntry } from '../data/blog-schema';

export interface Props {
  slug: string;
  entry: BlogSchemaEntry;
  /** Set false if the page already contains its own FAQ markup */
  renderFaq?: boolean;
}

const { slug, entry, renderFaq = true } = Astro.props;
const graph = buildBlogSchemaGraph(entry);
---

<script type="application/ld+json" set:html={JSON.stringify(graph)} />

{
  renderFaq && entry.faq.length > 0 && (
    <section class="mt-14 pt-8 border-t border-gray-200">
      <h2 class="text-2xl font-bold text-navy mb-6">Frequently asked questions</h2>
      <div class="space-y-6">
        {entry.faq.map((f) => (
          <div>
            <h3 class="text-lg font-semibold text-navy mb-2">{f.q}</h3>
            <p class="text-stone leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
    </section>
  )
}

{
  entry.related.length > 0 && (
    <nav class="mt-12 pt-8 border-t border-gray-200" aria-label="Related reading">
      <h2 class="text-lg font-bold text-navy mb-4">Related reading</h2>
      <ul class="space-y-2">
        {entry.related.map((r) => (
          <li>
            <a href={r.href} class="text-accent hover:underline">
              {r.label} &rarr;
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
