---
// src/components/Picture.astro — Responsive WebP with srcset + fallback
// Only reference variant widths that actually exist on disk, so a missing
// @1920 (or any other) derivative can never produce a broken <source>.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
const { src, alt, cls = '', loading = 'lazy', sizes, priority } = Astro.props;

const isSvg = (src || '').endsWith('.svg');
const isPng = (src || '').endsWith('.png');
const name = (src || '').replace(/\.[^.]+$/, '');
const sizesAttr = sizes || '(max-width: 480px) 100vw, (max-width: 768px) 100vw, (max-width: 1024px) 50vw, 100vw';

const RESPO_DIR = join(process.cwd(), 'public', 'factory', 'images', 'responsive');
const CANDIDATE_WIDTHS = [480, 768, 800, 1024, 1880, 1920];

// Collect only widths whose file exists; the largest original-size derivative
// (e.g. @1880) is picked up automatically through the widest existing entry.
const availableWidths = CANDIDATE_WIDTHS.filter((w) =>
  existsSync(join(RESPO_DIR, `${name}@${w}.webp`))
);

const srcset = availableWidths
  .map((w) => `/factory/images/responsive/${name}@${w}.webp ${w}w`)
  .join(', ');

const hasResponsive = availableWidths.length > 0;
---

{ isSvg || isPng || !hasResponsive ? (
  <img src={`/factory/images/${src}`} alt={alt} class={cls} loading={loading} />
) : (
  <picture>
    <source type="image/webp" srcset={srcset} sizes={sizesAttr} />
    <img src={`/factory/images/${src}`} alt={alt} class={cls} loading={loading} decoding="async" />
  </picture>
)}
