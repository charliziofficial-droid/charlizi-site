/** Look up a style by category + slug */
export function getStyleContent(category: string, slug: string): StyleContent | undefined {
  return styleContent[`${category}/${slug}`];
}

/** All styles in a category */
export function getCategoryStyles(category: string): StyleContent[] {
  return Object.values(styleContent).filter((s) => s.category === category);
}
